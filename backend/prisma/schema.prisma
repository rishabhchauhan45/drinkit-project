generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  DELIVERY_PARTNER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  phone           String           @unique
  name            String
  age             Int
  isVerified      Boolean          @default(false)
  password        String
  role            UserRole         @default(USER)
  addresses       Address[]
  orders          Order[]
  deliveryProfile DeliveryProfile?
  deliveries      Order[]          @relation("DeliveryPartner")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([email])
  @@index([phone])
}

model DeliveryProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType        String
  vehicleNumber      String
  isOnline           Boolean  @default(false)
  currentLocationLat Float?
  currentLocationLng Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  address   String
  landmark  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  products          Json
  totalAmount       Float
  deliveryFee       Float
  tax               Float
  discount          Float         @default(0)
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(PENDING)
  deliveryId        String?
  delivery          Delivery?
  deliveryPartnerId String?
  deliveryPartner   User?         @relation("DeliveryPartner", fields: [deliveryPartnerId], references: [id])
  payments          Payment[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([deliveryPartnerId])
}

model Delivery {
  id            String         @id @default(cuid())
  orderId       String         @unique
  order         Order          @relation(fields: [orderId], references: [id])
  partnerId     String
  partnerName   String
  partnerPhone  String
  currentLat    Float
  currentLng    Float
  status        DeliveryStatus @default(ASSIGNED)
  estimatedTime Int
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([orderId])
  @@index([partnerId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   Json
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  amount            Float
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  provider          String        @default("RAZORPAY")
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
  @@index([razorpayOrderId])
}
